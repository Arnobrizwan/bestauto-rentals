# Required — any Postgres connection string (Neon, Supabase, local)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Optional — set either one to switch all four AI agents to a hosted model.
# With neither set the app runs on its built-in deterministic engines.
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5"
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4.1-mini"

# Optional — makes automation actions deliver for real instead of queueing.
# SLACK_WEBHOOK_URL=""
# RESEND_API_KEY=""

# Optional — protects the scheduled digest endpoint.
# CRON_SECRET=""

# Optional — enables HMAC-SHA256 verification per webhook source.
# WEBHOOK_SECRET_STRIPE=""
# WEBHOOK_SECRET_PARTNER=""
