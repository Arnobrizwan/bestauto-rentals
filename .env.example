# Required — any Postgres connection string (Neon, Supabase, local)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Required in production — signs admin session cookies. 32+ characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Seed-time only — the admin account `npm run db:seed` creates.
# SEED_ADMIN_PASSWORD has no default; the seed fails without it rather than
# creating an account with a password that is written down in this repo.
SEED_ADMIN_EMAIL="ops@bestauto.co.uk"
SEED_ADMIN_NAME="Mike Witzel"
SEED_ADMIN_PASSWORD=""

# Optional — shows a click-to-fill credentials panel on the login page.
# Intended for review deployments only. Off unless set to exactly "true".
# SHOW_DEMO_CREDENTIALS="false"
# DEMO_ADMIN_EMAIL=""
# DEMO_ADMIN_PASSWORD=""

# Optional — set either one to switch all four AI agents to a hosted model.
# With neither set the app runs on its built-in deterministic engines.
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5"
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4.1-mini"

# Optional — makes automation actions deliver for real instead of queueing.
# SLACK_WEBHOOK_URL=""
# RESEND_API_KEY=""

# Optional — protects the scheduled digest endpoint.
# CRON_SECRET=""

# Optional — enables HMAC-SHA256 verification per webhook source.
# WEBHOOK_SECRET_STRIPE=""
# WEBHOOK_SECRET_PARTNER=""
