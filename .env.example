# Required — any Postgres connection string (Neon, Supabase, local)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Required in production — signs admin session cookies. 32+ characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Optional — provision an administrator non-interactively (handy in CI).
# All three are required together. Leave them unset and the seed creates no
# account: the first visit to /setup makes the administrator through the UI.
# SEED_ADMIN_EMAIL=""
# SEED_ADMIN_NAME=""
# SEED_ADMIN_PASSWORD=""

# Optional — set either one to switch all four AI agents to a hosted model.
# With neither set the app runs on its built-in deterministic engines.
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5"
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4.1-mini"

# Optional — makes automation actions deliver for real instead of queueing.
# SLACK_WEBHOOK_URL=""
# RESEND_API_KEY=""
# Sender for outbox email. Defaults to Resend's shared sandbox address, which
# any key can post from; set this to an address on a domain you have verified.
# RESEND_FROM="BestAuto <bookings@yourdomain.com>"

# Optional — protects the scheduled digest endpoint.
# CRON_SECRET=""

# Optional — enables HMAC-SHA256 verification per webhook source.
# WEBHOOK_SECRET_STRIPE=""
# WEBHOOK_SECRET_PARTNER=""
